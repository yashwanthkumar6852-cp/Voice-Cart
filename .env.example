# ==========================================
# VOICECART CONFIGURATION & API KEYS
# ==========================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------
# 1. AMAZON INDIA PA-API 5.0 CREDENTIALS
# Register at: https://affiliate-program.amazon.in/
# Tools -> Product Advertising API -> Add Credentials
# ------------------------------------------
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_ASSOCIATE_TAG=voicecart0a-21

# ------------------------------------------
# 2. FLIPKART AFFILIATE API CREDENTIALS
# Register at: https://affiliate.flipkart.com/
# Affiliate Tools -> API Credentials
# ------------------------------------------
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here

# ------------------------------------------
# 3. MEESHO PARTNER API
# Note: Meesho does not have a public developer portal.
# If you have official supplier/partner feed access, provide it here.
# Otherwise, VoiceCart gracefully marks Meesho as "Not Available" without scraping.
# ------------------------------------------
MEESHO_PARTNER_API_KEY=
MEESHO_PARTNER_ENDPOINT=

# ------------------------------------------
# 4. REDIS & POSTGRESQL (Optional - in-memory fallback enabled)
# ------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECONDS=300
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicecart

# ------------------------------------------
# 5. SPEECH & AI INTENT RECOGNITION
# Sarvam AI: https://www.sarvam.ai/
# Groq Whisper: https://console.groq.com/
# Google Gemini: https://aistudio.google.com/
# OpenAI: https://platform.openai.com/
# ------------------------------------------
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_SPEECH_API_KEY=

# ------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Optional for Direct Checkout)
# Dashboard: https://dashboard.razorpay.com/
# ------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MODE=test
